# Copy to .env (gitignored), here beside server/ and client/. The bot reads it; variables already set win.
OPENAI_API_KEY=     # the four characters, an LLM each
DEEPGRAM_API_KEY=   # Flux speech to text, and the four Aura-2 voices
DAILY_API_KEY=      # the dev runner makes a Daily room per session with it

# Optional
# HF_TOKEN=                         # downloads the model files (spellspeak/audience is private for now)
# OPENAI_MODEL=gpt-6-luna
# AUDIENCE_DIR=../../releases/rc1    # where Audience's model files and runtime are
# AUDIENCE_THREADS=4
# AUDIENCE_ENGINE=model              # model, or rules (the instant baseline, no model files needed)
# BOT_LOG_LEVEL=INFO                 # DEBUG adds each agent's view of the conversation
