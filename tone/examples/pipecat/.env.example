# Copy to .env (gitignored), here beside server/ and client/. The bot reads it; variables already set win.
OPENAI_API_KEY=      # the four characters, an LLM each
DEEPGRAM_API_KEY=    # Flux: speech to text, and when your turn ends
ELEVENLABS_API_KEY=  # the four voices, Eleven v4 Turbo
DAILY_API_KEY=       # the dev runner makes a Daily room per session with it

# Optional
# HF_TOKEN=                                      # not needed: the model files on Hugging Face are public
# OPENAI_MODEL=gpt-6-luna
# AUDIENCE_DIR=../../../audience/releases/rc2.1  # where Audience's model files and runtime are
# TONE_DIR=../../releases/rc2.1                  # where Tone's are
# MODEL_THREADS=4                                # CPU threads for each model
# AUDIENCE_ENGINE=model                          # model, or rules (Audience's instant baseline)
# BOT_LOG_LEVEL=INFO                             # DEBUG adds each agent's view of the conversation
